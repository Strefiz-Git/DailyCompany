<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Tema do splash, só isto. É o único sítio da app onde um "tema XML" é necessário:
      o SplashScreen (Android 12+) é desenhado pelo sistema ANTES do Compose arrancar,
      por isso não há CompositionLocal nem AppStrings aqui — é pintado com o Android View
      system clássico, na única janela em que isso é inevitável.

      Cores fixas (não vêm de Color.kt): têm de existir já no arranque do processo,
      antes de qualquer código Kotlin correr.
    -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Fundo: papel quente, igual ao md_light_background do tema Compose. -->
        <item name="windowSplashScreenBackground">#FFF8F5</item>

        <!-- Ícone central: vetor mono da app (cabide + sol), 240dp, sem animação de saída
             personalizada — usa-se o crossfade por omissão do sistema. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>

        <!-- Depois do splash, entra-se diretamente no tema normal da Activity;
             quem decide claro/escuro a partir daqui é o DailyCompanyTheme em Compose. -->
        <item name="postSplashScreenTheme">@style/Theme.App</item>
    </style>

    <!-- Tema "normal" da Activity depois do splash. Compose trata de tudo lá dentro;
         isto só precisa de existir e de ser um NoActionBar. -->
    <style name="Theme.App" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FFF8F5</item>
    </style>
</resources>
